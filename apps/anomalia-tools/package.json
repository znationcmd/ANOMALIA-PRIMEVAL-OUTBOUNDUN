{
  "name": "anomalia-tools",
  "version": "0.1.0",
  "private": true,
  "description": "ANOMALIA Tools - outils locaux de création de mods et ressources pour ANOMALIA",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis",
    "build": "vite build"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "yazl": "^3.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "fr.anomalia.tools",
    "productName": "ANOMALIA Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "dist/**",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
