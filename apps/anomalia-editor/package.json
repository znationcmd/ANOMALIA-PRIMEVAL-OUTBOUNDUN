{
  "name": "anomalia-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Éditeur de scènes 3D indépendant inspiré du flux de travail de DayZ Editor",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "desktop:dev": "npm run build && npm run prepare:icon && electron .",
    "desktop:package": "npm run build && npm run prepare:icon && electron-builder --win nsis --publish never",
    "prepare:icon": "node desktop/prepare-icon.cjs"
  },
  "dependencies": {
    "three": "^0.169.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "vite": "^5.4.19",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "fr.anomalia.editor",
    "productName": "ANOMALIA Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/anomalia-editor.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/anomalia-editor.ico",
      "uninstallerIcon": "assets/anomalia-editor.ico",
      "installerHeaderIcon": "assets/anomalia-editor.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/znationcmd/ANOMALIA-PRIMEVAL-OUTBOUNDUN/releases/download/anomalia-editor-latest/"
      }
    ]
  }
}
