{
  "name": "cmd-studio",
  "version": "0.2.2",
  "private": true,
  "description": "CMD Studio Game Creator - atelier 3D local pour ANOMALIA et autres jeux",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/prepare-icon.cjs && npm run build:art && npm run build:viewer && electron .",
    "test": "node --test tests/*.test.js",
    "package:win": "node scripts/prepare-icon.cjs && npm run build:art && npm run build:viewer && electron-builder --win nsis",
    "build:viewer": "node scripts/build-viewer.cjs",
    "build:art": "node scripts/download-art.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "esbuild": "^0.25.5",
    "three": "^0.169.0"
  },
  "build": {
    "appId": "fr.cmd.studio",
    "productName": "CMD Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "ui/**",
      "scripts/**",
      "package.json",
      "resources/**",
      "updates.cjs",
      "update-policy.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/cmd-studio-256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "resources/cmd-studio-256.ico",
      "uninstallerIcon": "resources/cmd-studio-256.ico",
      "installerHeaderIcon": "resources/cmd-studio-256.ico"
    },
    "publish": null
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
