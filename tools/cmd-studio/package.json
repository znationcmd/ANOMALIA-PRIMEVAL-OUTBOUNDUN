{
  "name": "cmd-studio",
  "version": "0.1.1",
  "private": true,
  "description": "CMD Studio Game Creator - atelier 3D local pour ANOMALIA et autres jeux",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/prepare-icon.cjs && electron .",
    "test": "node --test tests/*.test.js",
    "package:win": "node scripts/prepare-icon.cjs && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "fr.cmd.studio",
    "productName": "CMD Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "ui/**",
      "scripts/**",
      "package.json",
      "resources/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/cmd-studio-256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "resources/cmd-studio-256.ico",
      "uninstallerIcon": "resources/cmd-studio-256.ico",
      "installerHeaderIcon": "resources/cmd-studio-256.ico"
    }
  }
}
