{
  "name": "anomalia-primeval-outboundun",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Prototype original d'un monde ouvert 3D procedural de survie",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "test:browser": "node scripts/browser-smoke.mjs",
    "server": "node server/server.mjs",
    "measure:land": "node scripts/measure-land.mjs 25"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "three": "^0.172.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "1.51.1",
    "vite": "^6.3.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.cmd.anomalia.primevaloutboundun",
    "productName": "ANOMALIA PRIMEVAL OUTBOUNDUN",
    "copyright": "Copyright 2026 ANOMALIA PRIMEVAL OUTBOUNDUN",
    "asar": true,
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANOMALIA PRIMEVAL OUTBOUNDUN",
      "artifactName": "ANOMALIA-PRIMEVAL-OUTBOUNDUN-Setup-${version}-${arch}.${ext}"
    }
  }
}
