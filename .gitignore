# ANOMALIA — Unreal Engine machine-local and generated files.
# Do not ignore Content/*.umap or Content/*.uasset: original Unreal assets are versioned.
unreal/Binaries/
unreal/Intermediate/
unreal/DerivedDataCache/
unreal/Saved/
unreal/.vs/
unreal/*.sln
unreal/*.suo
unreal/TerrainSource/
unreal/TerrainPreview/
unreal/**/Collections/
unreal/**/Developers/
# Generated IDE/configuration build files
.vs/
*.VC.db
*.VC.opendb
# JavaScript dependency caches (existing tracked files remain tracked)
node_modules/
dist/
*.log
.DS_Store
Thumbs.db

# Generated, hash-owned copies of public/config runtime defaults.
unreal/Content/Anomalia/Data/

# Local Python verification caches
__pycache__/
*.pyc

# Native executable identity is generated from the validated CI source commit.
unreal/Build/AnomaliaSourceCommit.generated.txt

# Reproducible, source-hash-verified CC0 sedan derivatives; import remains separate.
unreal/SourceAssets/NativeDemoSedan_v1/
unreal/SourceAssets/NativeDemoSedan_v2/
unreal/SourceAssets/NativeDemoSedan_v3/
